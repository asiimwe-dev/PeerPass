# Copy to `.env` and fill in. Never commit the filled-in file.
#
# Every value here is required unless marked optional. Settings refuses to start
# without a database URL, a signing key, or a token pepper: an API that boots
# without a signing key will happily issue tokens nobody can revoke, and one
# that boots without a pepper can be checked offline against a stolen database.

# Optional. One of: development, staging, production.
#
# Defaults to development so a fresh checkout runs with nothing configured. A
# real deployment must set this, and it is what refuses the settings that are
# unsafe outside development -- see DATABASE_ECHO below.
ENVIRONMENT=development

# SQLAlchemy URL. Use the `postgresql+psycopg` driver, which is async-capable.
DATABASE_URL=postgresql+psycopg://peerpass:peerpass@localhost:5432/peerpass

# Primary signing key for access and refresh tokens, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating this invalidates every issued token and signs every user out, UNLESS
# the old key is listed in JWT_PREVIOUS_SECRETS first. To rotate with no
# downtime: move the current value into JWT_PREVIOUS_SECRETS, put the new value
# here, deploy, wait out the longest token lifetime, then drop the old key.
JWT_SECRET=Zipfile5-Askew7-Justice6-Suitably1-Tinkling0

# HS256 is adequate for a single service. Move to RS256 before a second service
# needs to verify tokens without being able to mint them.
JWT_ALGORITHM=HS256

# Optional. Comma-separated retired signing keys, accepted for verification
# only. Empty on a fresh deployment. See JWT_SECRET above for the rotation
# procedure this exists to make possible.
JWT_PREVIOUS_SECRETS=

# Server-side pepper for hashing refresh and email-verification tokens, at least
# 32 characters. Generate a fresh value, do not reuse JWT_SECRET.
#
# Distinct from the signing key on purpose: they protect different things, and
# rotating one should not take the other out. Rotating this signs every user
# out, because no stored token hash will match afterwards.
TOKEN_PEPPER=MYwG7sR2#cmu0xXA1%hNg3&BPnWTCxVwJ9bnD*kj

# Access token lifetime in minutes. Kept short so rotation is exercised.
ACCESS_TOKEN_TTL=15

# Refresh token lifetime in days.
REFRESH_TOKEN_TTL=30

# Argon2id password hashing. The defaults are the OWASP floor, which is the
# right starting point for a small instance because the cost is paid in resident
# memory per concurrent sign-in rather than in CPU time.
#
# Raising these is NOT a migration. Every stored hash records the parameters it
# was made with, and a successful sign-in rewrites any hash made under weaker
# settings, so a raised floor reaches accounts gradually on their own.
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_PARALLELISM=1

# Optional. Logs every SQL statement, including its bound parameters. Refused
# unless ENVIRONMENT is development, because the rows it prints are the ones
# holding email addresses and password hashes.
DATABASE_ECHO=false

# Optional. Comma-separated browser origins. Empty by default -- the pilot is a
# mobile client, and an accidental wildcard would expose the API to any site.
CORS_ORIGINS=
