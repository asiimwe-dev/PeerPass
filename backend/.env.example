# Copy to `.env` and fill in. Never commit the filled-in file.
#
# Every value here is required unless marked optional. Settings refuses to start
# without a database URL or a signing key, because an API that boots without them
# will happily issue tokens nobody can revoke.

# SQLAlchemy URL. Use the `postgresql+psycopg` driver, which is async-capable.
DATABASE_URL=postgresql+psycopg://peerpass:peerpass@localhost:5432/peerpass

# Signing key for access and refresh tokens, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every issued token, signing every user out.
JWT_SECRET=

# HS256 is adequate for a single service. Move to RS256 before a second service
# needs to verify tokens without being able to mint them.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes. Kept short so rotation is exercised.
ACCESS_TOKEN_TTL=15

# Refresh token lifetime in days.
REFRESH_TOKEN_TTL=30

# Optional. Logs every SQL statement. Development only: it will print the
# contents of the rows being written.
DATABASE_ECHO=false

# Optional. Comma-separated browser origins. Empty by default -- the pilot is a
# mobile client, and an accidental wildcard would expose the API to any site.
CORS_ORIGINS=
